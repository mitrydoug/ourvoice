# Local development — mocked registry (no Sepolia fork).
# Launched via: make local-mocked
#
# Meilisearch runs in Docker (started by Makefile before overmind).
# Everything else runs natively.

hardhat:  cd blockchain && npx hardhat node
frontend: VITE_NETWORK=localhost VITE_REGISTRY_MODE=mocked DEPLOY_NETWORK=localhost ./scripts/local-deploy-and-serve.sh
backend:  NETWORK_FILE_NAME=localhost ./scripts/local-backend.sh
