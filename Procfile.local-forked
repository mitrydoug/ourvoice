# Local development — Sepolia fork with real ZKPassport verifier.
# Launched via: make local-forked
#
# Requires SEPOLIA_RPC_URL in .env.local (gitignored).
# Meilisearch runs in Docker (started by Makefile before overmind).
# Everything else runs natively.

hardhat:  cd blockchain && npx hardhat node --network local_sepolia_fork
frontend: VITE_NETWORK=localhost VITE_REGISTRY_MODE=production DEPLOY_NETWORK=localhost_forked ./scripts/local-deploy-and-serve.sh
backend:  NETWORK_FILE_NAME=localhost ./scripts/local-backend.sh
