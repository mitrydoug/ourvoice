FROM python:3.12-slim

WORKDIR /app

# Install dependencies first for layer caching
COPY requirements.txt .
RUN pip install --no-cache-dir uv && uv pip sync --system requirements.txt

COPY src/ src/

# Default to combined mode; override CMD in Railway service config
# for split mode (indexer-only or api-only).
ENV PORT=8000
EXPOSE $PORT

CMD ["uvicorn", "ourvoice.combined:app", "--host", "0.0.0.0", "--port", "8000"]
