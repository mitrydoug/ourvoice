# Local dev — mocked registry, no public-network fork.
# Backend reads on-chain from the local Hardhat node; frontend reads via local relay.
INDEXER_RPC_URL=${LOCAL_RPC_URL}
RELAY_RPC_URL=${LOCAL_RPC_URL}
VITE_RPC_URL=${LOCAL_BACKEND_RPC_URL}
VITE_BACKEND_URL=${LOCAL_BACKEND_URL}
VITE_NETWORK=localhost
VITE_REGISTRY_MODE=mocked
DEPLOY_NETWORK=localhost
DEPLOYMENT_PROFILE=local-mocked
SEED_PROFILE=standard
