# CI deploy profile — develop branch → Base Sepolia, deployed dev backend.
# Frontend-only build config. RPC + search point at the deployed dev backend.
BACKEND_URL=https://symvolia-backend-development.up.railway.app
VITE_NETWORK=base_sepolia
VITE_REGISTRY_MODE=mocked
VITE_RPC_URL=${BACKEND_URL}/rpc
VITE_SEARCH_URL=${BACKEND_URL}
VITE_ENABLE_GAS_SPONSORSHIP=true
VITE_CHART_PERIOD_SECONDS=86400
REQUIRE="VITE_NETWORK VITE_REGISTRY_MODE VITE_RPC_URL VITE_SEARCH_URL VITE_ENABLE_GAS_SPONSORSHIP VITE_ALCHEMY_GAS_POLICY_ID"
