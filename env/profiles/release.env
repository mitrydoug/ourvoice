# CI deploy profile — release branch → Base mainnet, deployed prod backend.
# Frontend-only build config. RPC + search point at the deployed prod backend.
BACKEND_URL=https://symvolia-backend-production.up.railway.app
VITE_NETWORK=base
VITE_REGISTRY_MODE=production
VITE_RPC_URL=${BACKEND_URL}/rpc
VITE_BACKEND_URL=${BACKEND_URL}
# Backend text search is disabled while Meilisearch is offline; other backend
# endpoints (gas-sponsorship eligibility) still work via VITE_BACKEND_URL.
VITE_ENABLE_BACKEND_SEARCH=false
VITE_ENABLE_GAS_SPONSORSHIP=true
VITE_ALCHEMY_GAS_POLICY_ID=REPLACE_WITH_PROD_ALCHEMY_GAS_POLICY_ID
VITE_CHART_PERIOD_SECONDS=86400
REQUIRE="VITE_NETWORK VITE_REGISTRY_MODE VITE_RPC_URL VITE_ENABLE_GAS_SPONSORSHIP VITE_ALCHEMY_GAS_POLICY_ID"
