FROM node:22-alpine AS builder
WORKDIR /app
COPY . .
RUN npm install
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY ./vite.config.js ./vite.config.js
RUN npm install --save-dev vite @vitejs/plugin-react vite-plugin-node-polyfills

EXPOSE 4173
CMD ["npx", "vite", "preview"]