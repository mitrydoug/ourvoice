# Registry mode: "mocked" uses MockOurVoiceRegistry, "production" uses OurVoiceRegistry.
# Default to mocked for local development.
VITE_REGISTRY_MODE=mocked

# Which network address file to load from src/contracts/networks/.
VITE_NETWORK=localhost

# Search API URL. Defaults to local docker-compose backend.
VITE_SEARCH_URL=http://localhost:8000

# Chart period for support-over-time chart (seconds).
# Dev: 360s (6 min periods → 42 min chart). Production default: 86400 (1 day).
VITE_CHART_PERIOD_SECONDS=360
