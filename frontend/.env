# Registry mode: "mocked" uses MockSymvoliaRegistry, "production" uses SymvoliaRegistry.
# Default to mocked for local development.
VITE_REGISTRY_MODE=mocked

# Which network address file to load from src/contracts/networks/.
VITE_NETWORK=localhost

# RPC relay URL for the selected VITE_NETWORK.
VITE_LOCALHOST_RPC_URL=http://localhost:8000/rpc

# Privy app ID for embedded wallet and external wallet login.
VITE_PRIVY_APP_ID=cmpu9bmad00wo0cjojg34mdf3

# Search API URL. Defaults to local docker-compose backend.
VITE_SEARCH_URL=http://localhost:8000

# Chart period for support-over-time chart (seconds).
# Dev: 360s (6 min periods → 42 min chart). Production default: 86400 (1 day).
VITE_CHART_PERIOD_SECONDS=360

# How often (seconds) the frontend polls for a new block and refreshes contract data.
# Lower values give faster UI updates at the cost of more RPC calls.
VITE_BLOCK_POLLING_INTERVAL_SECONDS=60
